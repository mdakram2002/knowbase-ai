# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/knowbase-ai
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/knowbase-ai
MONGODB_URI=mongodb://localhost:27017/knowbase-ai

# Google Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (for guest sessions and caching)
# For local Redis: localhost:6379
# For production Redis: use your Redis Cloud URL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456789
JWT_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Feature Flags
FEATURE_GUEST_MODE=true
FEATURE_RATE_LIMITING=true
FEATURE_CACHING=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_OAUTH=false
